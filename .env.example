# 백엔드와 공유하는 내부 인증 토큰 (필수, 실제 값은 커밋 금지)
AI_INTERNAL_TOKEN=change-me
# mock: 규칙 기반(학습 전·GPU 없음) / sllm: 파인튜닝 모델
REC_BACKEND=mock
REC_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
REC_ADAPTER_DIR=outputs/rec_sllm_v2/adapter
# 정답 길이 p95≈2,170자(토큰 1,450~2,000). 1800이면 긴 답이 JSON 중간에서 잘려 폴백으로 빠짐
REC_MAX_NEW_TOKENS=2400
# 7B 4-bit로 1,000~1,500토큰 생성 ≈ 30~75초. 백엔드 호출 타임아웃은 이 값보다 길게(docs/ai-module.md §6)
REC_TIMEOUT_S=120
# stub: 박성근 회귀 모델 연결 전 / model: 연결 후
SKIN_BACKEND=stub
QUEUE_LIMIT=20
# 모델 캐시를 D드라이브로 (7B 모델 약 15GB)
HF_HOME=D:/hf_cache
